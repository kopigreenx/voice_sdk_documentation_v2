[{"data":1,"prerenderedAt":259},["ShallowReactive",2],{"navigation":3,"\u002Fgetting-started\u002Fintroduction":68,"\u002Fgetting-started\u002Fintroduction-surround":255},[4,26,51],{"title":5,"path":6,"stem":7,"children":8,"page":25},"Getting Started","\u002Fgetting-started","1.getting-started",[9,13,17,21],{"title":10,"path":11,"stem":12},"Introduction","\u002Fgetting-started\u002Fintroduction","1.getting-started\u002F1.introduction",{"title":14,"path":15,"stem":16},"Installation","\u002Fgetting-started\u002Finstallation","1.getting-started\u002F2.installation",{"title":18,"path":19,"stem":20},"Quick Start","\u002Fgetting-started\u002Fquick-start","1.getting-started\u002F3.quick-start",{"title":22,"path":23,"stem":24},"Configuration","\u002Fgetting-started\u002Fconfiguration","1.getting-started\u002F4.configuration",false,{"title":27,"path":28,"stem":29,"children":30,"page":25},"Guides","\u002Fguides","2.guides",[31,35,39,43,47],{"title":32,"path":33,"stem":34},"Outbound Calls","\u002Fguides\u002Foutbound-calls","2.guides\u002F1.outbound-calls",{"title":36,"path":37,"stem":38},"Inbound Calls","\u002Fguides\u002Finbound-calls","2.guides\u002F2.inbound-calls",{"title":40,"path":41,"stem":42},"Agent Status","\u002Fguides\u002Fagent-status","2.guides\u002F3.agent-status",{"title":44,"path":45,"stem":46},"Audio Devices","\u002Fguides\u002Faudio-devices","2.guides\u002F4.audio-devices",{"title":48,"path":49,"stem":50},"Monitoring","\u002Fguides\u002Fmonitoring","2.guides\u002F5.monitoring",{"title":52,"path":53,"stem":54,"children":55,"page":25},"Api Reference","\u002Fapi-reference","3.api-reference",[56,60,64],{"title":57,"path":58,"stem":59},"Methods","\u002Fapi-reference\u002Fmethods","3.api-reference\u002F1.methods",{"title":61,"path":62,"stem":63},"Events","\u002Fapi-reference\u002Fevents","3.api-reference\u002F2.events",{"title":65,"path":66,"stem":67},"Error Handling","\u002Fapi-reference\u002Ferror-handling","3.api-reference\u002F3.error-handling",{"id":69,"title":10,"body":70,"description":249,"extension":250,"meta":251,"navigation":252,"path":11,"seo":253,"stem":12,"__hash__":254},"docs\u002F1.getting-started\u002F1.introduction.md",{"type":71,"value":72,"toc":242},"minimark",[73,77,89,94,140,144,207,218,222,232],[74,75,10],"h1",{"id":76},"introduction",[78,79,80,81,88],"p",{},"SocioVoice SDK is a JavaScript library for embedding voice calls into web apps via the ",[82,83,87],"a",{"href":84,"rel":85},"https:\u002F\u002Fsociomile.com",[86],"nofollow","Sociomile"," contact-centre platform. Add it to your page, supply credentials, and you get outbound dialling, inbound call handling, agent state management, and real-time events — without touching SIP, WebSockets, or audio plumbing directly.",[90,91,93],"h2",{"id":92},"key-features","Key features",[95,96,97,105,111,117,128,134],"ul",{},[98,99,100,104],"li",{},[101,102,103],"strong",{},"Outbound calls"," — dial by phone number, send DTMF, hold\u002Funhold, mute\u002Funmute, hang up",[98,106,107,110],{},[101,108,109],{},"Inbound calls"," — answer or reject, hold, transfer, send CSAT surveys",[98,112,113,116],{},[101,114,115],{},"Agent management"," — toggle ready\u002Fnot-ready state, start and end break sessions",[98,118,119,122,123,127],{},[101,120,121],{},"Real-time events"," — single ",[124,125,126],"code",{},"sociomileEvent"," listener covers auth, SIP, call lifecycle, WebSocket, and device changes",[98,129,130,133],{},[101,131,132],{},"Audio device control"," — enumerate, select, and switch microphone\u002Fspeaker at runtime",[98,135,136,139],{},[101,137,138],{},"Call quality monitoring"," — optional per-call audio stats (MOS, jitter, packet loss) emitted every 2 seconds",[90,141,143],{"id":142},"supported-environments","Supported environments",[145,146,147,160],"table",{},[148,149,150],"thead",{},[151,152,153,157],"tr",{},[154,155,156],"th",{},"Environment",[154,158,159],{},"How to load",[161,162,163,179,194],"tbody",{},[151,164,165,173],{},[166,167,168,169,172],"td",{},"Browser (",[124,170,171],{},"\u003Cscript>",")",[166,174,175,176],{},"UMD bundle via CDN or local ",[124,177,178],{},"dist\u002F",[151,180,181,184],{},[166,182,183],{},"ES Module (Vite, Webpack, Rollup)",[166,185,186,189,190,193],{},[124,187,188],{},"import"," from ",[124,191,192],{},"dist\u002Fesm\u002F"," or the npm package",[151,195,196,199],{},[166,197,198],{},"CommonJS (Node.js)",[166,200,201,189,204,193],{},[124,202,203],{},"require()",[124,205,206],{},"dist\u002Fcjs\u002F",[208,209,211],"callout",{"type":210},"warning",[78,212,213,214,217],{},"SIP and WebRTC audio require a real browser environment. The Node.js CommonJS build is suitable for server-side tooling (event forwarding, webhooks) but ",[101,215,216],{},"cannot place or receive calls",".",[90,219,221],{"id":220},"architecture-overview","Architecture overview",[223,224,229],"pre",{"className":225,"code":227,"language":228},[226],"language-text","Your app\n  └─ new Init({ base_url, secret_key })\n       │\n       ├─ 1. checkAuth()       → validates secret_key with Sociomile API\n       ├─ 2. sipInit()         → registers SIP UA (WebRTC)\n       ├─ 3. initWebSocket()   → subscribes Pusher channel for agent events\n       │\n       └─ emits 'sociomileEvent' for every state change\n","text",[124,230,227],{"__ignoreMap":231},"",[78,233,234,237,238,241],{},[124,235,236],{},".start()"," runs all three steps in order. Once ",[124,239,240],{},"on_registered"," fires, the SDK is ready to dial or receive calls.",{"title":231,"searchDepth":243,"depth":244,"links":245},1,2,[246,247,248],{"id":92,"depth":244,"text":93},{"id":142,"depth":244,"text":143},{"id":220,"depth":244,"text":221},"What is SocioVoice SDK and how does it work?","md",{},true,{"title":10,"description":249},"G-JOlsnQBnMZZ4HW_LO_WERAqOmkIN3X-kbOcY9Ncz4",[256,257],null,{"title":14,"path":15,"stem":16,"description":258,"children":-1},"Install SocioVoice SDK via npm, yarn, or CDN.",1782814025596]
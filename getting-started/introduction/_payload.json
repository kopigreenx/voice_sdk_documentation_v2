[{"data":1,"prerenderedAt":263},["ShallowReactive",2],{"navigation":3,"\u002Fgetting-started\u002Fintroduction":72,"\u002Fgetting-started\u002Fintroduction-surround":259},[4,26,55],{"title":5,"path":6,"stem":7,"children":8,"page":25},"Getting Started","\u002Fgetting-started","1.getting-started",[9,13,17,21],{"title":10,"path":11,"stem":12},"Introduction","\u002Fgetting-started\u002Fintroduction","1.getting-started\u002F1.introduction",{"title":14,"path":15,"stem":16},"Installation","\u002Fgetting-started\u002Finstallation","1.getting-started\u002F2.installation",{"title":18,"path":19,"stem":20},"Quick Start","\u002Fgetting-started\u002Fquick-start","1.getting-started\u002F3.quick-start",{"title":22,"path":23,"stem":24},"Configuration","\u002Fgetting-started\u002Fconfiguration","1.getting-started\u002F4.configuration",false,{"title":27,"path":28,"stem":29,"children":30,"page":25},"Guides","\u002Fguides","2.guides",[31,35,39,43,47,51],{"title":32,"path":33,"stem":34},"Outbound Calls","\u002Fguides\u002Foutbound-calls","2.guides\u002F1.outbound-calls",{"title":36,"path":37,"stem":38},"Inbound Calls","\u002Fguides\u002Finbound-calls","2.guides\u002F2.inbound-calls",{"title":40,"path":41,"stem":42},"Agent Status","\u002Fguides\u002Fagent-status","2.guides\u002F3.agent-status",{"title":44,"path":45,"stem":46},"Audio Devices","\u002Fguides\u002Faudio-devices","2.guides\u002F4.audio-devices",{"title":48,"path":49,"stem":50},"Monitoring","\u002Fguides\u002Fmonitoring","2.guides\u002F5.monitoring",{"title":52,"path":53,"stem":54},"Tips & Tricks","\u002Fguides\u002Ftips-and-tricks","2.guides\u002F6.tips-and-tricks",{"title":56,"path":57,"stem":58,"children":59,"page":25},"Api Reference","\u002Fapi-reference","3.api-reference",[60,64,68],{"title":61,"path":62,"stem":63},"Methods","\u002Fapi-reference\u002Fmethods","3.api-reference\u002F1.methods",{"title":65,"path":66,"stem":67},"Events","\u002Fapi-reference\u002Fevents","3.api-reference\u002F2.events",{"title":69,"path":70,"stem":71},"Error Handling","\u002Fapi-reference\u002Ferror-handling","3.api-reference\u002F3.error-handling",{"id":73,"title":10,"body":74,"description":253,"extension":254,"meta":255,"navigation":256,"path":11,"seo":257,"stem":12,"__hash__":258},"docs\u002F1.getting-started\u002F1.introduction.md",{"type":75,"value":76,"toc":246},"minimark",[77,81,93,98,144,148,211,222,226,236],[78,79,10],"h1",{"id":80},"introduction",[82,83,84,85,92],"p",{},"SocioVoice SDK is a JavaScript library for embedding voice calls into web apps via the ",[86,87,91],"a",{"href":88,"rel":89},"https:\u002F\u002Fsociomile.com",[90],"nofollow","Sociomile"," contact-centre platform. Add it to your page, supply credentials, and you get outbound dialling, inbound call handling, agent state management, and real-time events — without touching SIP, WebSockets, or audio plumbing directly.",[94,95,97],"h2",{"id":96},"key-features","Key features",[99,100,101,109,115,121,132,138],"ul",{},[102,103,104,108],"li",{},[105,106,107],"strong",{},"Outbound calls"," — dial by phone number, send DTMF, hold\u002Funhold, mute\u002Funmute, hang up",[102,110,111,114],{},[105,112,113],{},"Inbound calls"," — answer or reject, hold, transfer, send CSAT surveys",[102,116,117,120],{},[105,118,119],{},"Agent management"," — toggle ready\u002Fnot-ready state, start and end break sessions",[102,122,123,126,127,131],{},[105,124,125],{},"Real-time events"," — single ",[128,129,130],"code",{},"sociomileEvent"," listener covers auth, SIP, call lifecycle, WebSocket, and device changes",[102,133,134,137],{},[105,135,136],{},"Audio device control"," — enumerate, select, and switch microphone\u002Fspeaker at runtime",[102,139,140,143],{},[105,141,142],{},"Call quality monitoring"," — optional per-call audio stats (MOS, jitter, packet loss) emitted every 2 seconds",[94,145,147],{"id":146},"supported-environments","Supported environments",[149,150,151,164],"table",{},[152,153,154],"thead",{},[155,156,157,161],"tr",{},[158,159,160],"th",{},"Environment",[158,162,163],{},"How to load",[165,166,167,183,198],"tbody",{},[155,168,169,177],{},[170,171,172,173,176],"td",{},"Browser (",[128,174,175],{},"\u003Cscript>",")",[170,178,179,180],{},"UMD bundle via CDN or local ",[128,181,182],{},"dist\u002F",[155,184,185,188],{},[170,186,187],{},"ES Module (Vite, Webpack, Rollup)",[170,189,190,193,194,197],{},[128,191,192],{},"import"," from ",[128,195,196],{},"dist\u002Fesm\u002F"," or the npm package",[155,199,200,203],{},[170,201,202],{},"CommonJS (Node.js)",[170,204,205,193,208,197],{},[128,206,207],{},"require()",[128,209,210],{},"dist\u002Fcjs\u002F",[212,213,215],"callout",{"type":214},"warning",[82,216,217,218,221],{},"SIP and WebRTC audio require a real browser environment. The Node.js CommonJS build is suitable for server-side tooling (event forwarding, webhooks) but ",[105,219,220],{},"cannot place or receive calls",".",[94,223,225],{"id":224},"architecture-overview","Architecture overview",[227,228,233],"pre",{"className":229,"code":231,"language":232},[230],"language-text","Your app\n  └─ new Init({ base_url, secret_key })\n       │\n       ├─ 1. checkAuth()       → validates secret_key with Sociomile API\n       ├─ 2. sipInit()         → registers SIP UA (WebRTC)\n       ├─ 3. initWebSocket()   → subscribes Pusher channel for agent events\n       │\n       └─ emits 'sociomileEvent' for every state change\n","text",[128,234,231],{"__ignoreMap":235},"",[82,237,238,241,242,245],{},[128,239,240],{},".start()"," runs all three steps in order. Once ",[128,243,244],{},"on_registered"," fires, the SDK is ready to dial or receive calls.",{"title":235,"searchDepth":247,"depth":248,"links":249},1,2,[250,251,252],{"id":96,"depth":248,"text":97},{"id":146,"depth":248,"text":147},{"id":224,"depth":248,"text":225},"What is SocioVoice SDK and how does it work?","md",{},true,{"title":10,"description":253},"G-JOlsnQBnMZZ4HW_LO_WERAqOmkIN3X-kbOcY9Ncz4",[260,261],null,{"title":14,"path":15,"stem":16,"description":262,"children":-1},"Install SocioVoice SDK via npm, yarn, or CDN.",1782827816140]
[{"data":1,"prerenderedAt":267},["ShallowReactive",2],{"navigation":3,"\u002Fgetting-started\u002Fintroduction":76,"\u002Fgetting-started\u002Fintroduction-surround":263},[4,26,59],{"title":5,"path":6,"stem":7,"children":8,"page":25},"Getting Started","\u002Fgetting-started","1.getting-started",[9,13,17,21],{"title":10,"path":11,"stem":12},"Introduction","\u002Fgetting-started\u002Fintroduction","1.getting-started\u002F1.introduction",{"title":14,"path":15,"stem":16},"Installation","\u002Fgetting-started\u002Finstallation","1.getting-started\u002F2.installation",{"title":18,"path":19,"stem":20},"Quick Start","\u002Fgetting-started\u002Fquick-start","1.getting-started\u002F3.quick-start",{"title":22,"path":23,"stem":24},"Configuration","\u002Fgetting-started\u002Fconfiguration","1.getting-started\u002F4.configuration",false,{"title":27,"path":28,"stem":29,"children":30,"page":25},"Guides","\u002Fguides","2.guides",[31,35,39,43,47,51,55],{"title":32,"path":33,"stem":34},"Outbound Calls","\u002Fguides\u002Foutbound-calls","2.guides\u002F1.outbound-calls",{"title":36,"path":37,"stem":38},"Inbound Calls","\u002Fguides\u002Finbound-calls","2.guides\u002F2.inbound-calls",{"title":40,"path":41,"stem":42},"Agent Status","\u002Fguides\u002Fagent-status","2.guides\u002F3.agent-status",{"title":44,"path":45,"stem":46},"Audio Devices","\u002Fguides\u002Faudio-devices","2.guides\u002F4.audio-devices",{"title":48,"path":49,"stem":50},"Monitoring","\u002Fguides\u002Fmonitoring","2.guides\u002F5.monitoring",{"title":52,"path":53,"stem":54},"Handling Incoming Calls","\u002Fguides\u002Fincoming-call-handling","2.guides\u002F6.incoming-call-handling",{"title":56,"path":57,"stem":58},"Tips & Tricks","\u002Fguides\u002Ftips-and-tricks","2.guides\u002F7.tips-and-tricks",{"title":60,"path":61,"stem":62,"children":63,"page":25},"Api Reference","\u002Fapi-reference","3.api-reference",[64,68,72],{"title":65,"path":66,"stem":67},"Methods","\u002Fapi-reference\u002Fmethods","3.api-reference\u002F1.methods",{"title":69,"path":70,"stem":71},"Events","\u002Fapi-reference\u002Fevents","3.api-reference\u002F2.events",{"title":73,"path":74,"stem":75},"Error Handling","\u002Fapi-reference\u002Ferror-handling","3.api-reference\u002F3.error-handling",{"id":77,"title":10,"body":78,"description":257,"extension":258,"meta":259,"navigation":260,"path":11,"seo":261,"stem":12,"__hash__":262},"docs\u002F1.getting-started\u002F1.introduction.md",{"type":79,"value":80,"toc":250},"minimark",[81,85,97,102,148,152,215,226,230,240],[82,83,10],"h1",{"id":84},"introduction",[86,87,88,89,96],"p",{},"SocioVoice SDK is a JavaScript library for embedding voice calls into web apps via the ",[90,91,95],"a",{"href":92,"rel":93},"https:\u002F\u002Fsociomile.com",[94],"nofollow","Sociomile"," contact-centre platform. Add it to your page, supply credentials, and you get outbound dialling, inbound call handling, agent state management, and real-time events — without touching SIP, WebSockets, or audio plumbing directly.",[98,99,101],"h2",{"id":100},"key-features","Key features",[103,104,105,113,119,125,136,142],"ul",{},[106,107,108,112],"li",{},[109,110,111],"strong",{},"Outbound calls"," — dial by phone number, send DTMF, hold\u002Funhold, mute\u002Funmute, hang up",[106,114,115,118],{},[109,116,117],{},"Inbound calls"," — answer or reject, hold, transfer, send CSAT surveys",[106,120,121,124],{},[109,122,123],{},"Agent management"," — toggle ready\u002Fnot-ready state, start and end break sessions",[106,126,127,130,131,135],{},[109,128,129],{},"Real-time events"," — single ",[132,133,134],"code",{},"sociomileEvent"," listener covers auth, SIP, call lifecycle, WebSocket, and device changes",[106,137,138,141],{},[109,139,140],{},"Audio device control"," — enumerate, select, and switch microphone\u002Fspeaker at runtime",[106,143,144,147],{},[109,145,146],{},"Call quality monitoring"," — optional per-call audio stats (MOS, jitter, packet loss) emitted every 2 seconds",[98,149,151],{"id":150},"supported-environments","Supported environments",[153,154,155,168],"table",{},[156,157,158],"thead",{},[159,160,161,165],"tr",{},[162,163,164],"th",{},"Environment",[162,166,167],{},"How to load",[169,170,171,187,202],"tbody",{},[159,172,173,181],{},[174,175,176,177,180],"td",{},"Browser (",[132,178,179],{},"\u003Cscript>",")",[174,182,183,184],{},"UMD bundle via CDN or local ",[132,185,186],{},"dist\u002F",[159,188,189,192],{},[174,190,191],{},"ES Module (Vite, Webpack, Rollup)",[174,193,194,197,198,201],{},[132,195,196],{},"import"," from ",[132,199,200],{},"dist\u002Fesm\u002F"," or the npm package",[159,203,204,207],{},[174,205,206],{},"CommonJS (Node.js)",[174,208,209,197,212,201],{},[132,210,211],{},"require()",[132,213,214],{},"dist\u002Fcjs\u002F",[216,217,219],"callout",{"type":218},"warning",[86,220,221,222,225],{},"SIP and WebRTC audio require a real browser environment. The Node.js CommonJS build is suitable for server-side tooling (event forwarding, webhooks) but ",[109,223,224],{},"cannot place or receive calls",".",[98,227,229],{"id":228},"architecture-overview","Architecture overview",[231,232,237],"pre",{"className":233,"code":235,"language":236},[234],"language-text","Your app\n  └─ new Init({ base_url, secret_key })\n       │\n       ├─ 1. checkAuth()       → validates secret_key with Sociomile API\n       ├─ 2. sipInit()         → registers SIP UA (WebRTC)\n       ├─ 3. initWebSocket()   → subscribes Pusher channel for agent events\n       │\n       └─ emits 'sociomileEvent' for every state change\n","text",[132,238,235],{"__ignoreMap":239},"",[86,241,242,245,246,249],{},[132,243,244],{},".start()"," runs all three steps in order. Once ",[132,247,248],{},"on_registered"," fires, the SDK is ready to dial or receive calls.",{"title":239,"searchDepth":251,"depth":252,"links":253},1,2,[254,255,256],{"id":100,"depth":252,"text":101},{"id":150,"depth":252,"text":151},{"id":228,"depth":252,"text":229},"What is SocioVoice SDK and how does it work?","md",{},true,{"title":10,"description":257},"G-JOlsnQBnMZZ4HW_LO_WERAqOmkIN3X-kbOcY9Ncz4",[264,265],null,{"title":14,"path":15,"stem":16,"description":266,"children":-1},"Install SocioVoice SDK via npm, yarn, or CDN.",1782840433797]
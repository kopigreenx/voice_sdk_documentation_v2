th the Wrong Session",[82,296,297],{},"There are two types of incoming calls — direct softphone calls and agent-to-agent (inbound queue) calls. Each requires a different hangup method.",[106,299,300,344],{},[109,301,303],{"className":111,"code":302,"filename":113,"language":114,"meta":115,"style":115},"\u002F\u002F Direct softphone incoming call — pass the session object\nvoice.hangup(callSessionIncoming)\n\n\u002F\u002F Agent-to-agent inbound call\nvoice.hangupInbound()\n",[97,304,305,310,322,328,333],{"__ignoreMap":115},[119,306,307],{"class":121,"line":122},[119,308,309],{"class":205},"\u002F\u002F Direct softphone incoming call — pass the session object\n",[119,311,312,314,316,319],{"class":121,"line":169},[119,313,126],{"class":125},[119,315,130],{"class":129},[119,317,318],{"class":133},"hangup",[119,320,321],{"class":125},"(callSessionIncoming)\n",[119,323,324],{"class":121,"line":202},[119,325,327],{"emptyLinePlaceholder":326},true,"\n",[119,329,330],{"class":121,"line":209},[119,331,332],{"class":205},"\u002F\u002F Agent-to-agent inbound call\n",[119,334,335,337,339,342],{"class":121,"line":218},[119,336,126],{"class":125},[119,338,130],{"class":129},[119,340,341],{"class":133},"hangupInbound",[119,343,215],{"class":125},[109,345,347],{"className":111,"code":346,"filename":234,"language":114,"meta":115,"style":115},"\u002F\u002F Calling hangup() without a session on an inbound call\nvoice.hangup() \u002F\u002F hangs up wrong session or does nothing\n",[97,348,349,354],{"__ignoreMap":115},[119,350,351],{"class":121,"line":122},[119,352,353],{"class":205},"\u002F\u002F Calling hangup() without a session on an inbound call\n",[119,355,356,358,360,362,365],{"class":121,"line":169},[119,357,126],{"class":125},[119,359,130],{"class":129},[119,361,318],{"class":133},[119,363,364],{"class":125},"() ",[119,366,367],{"class":205},"\u002F\u002F hangs up wrong session or does nothing\n",[82,369,370,374,375,378,379,382,383,386],{},[371,372,373],"strong",{},"Rule:"," Save the session from ",[97,376,377],{},"on_incoming_call"," event data. Use ",[97,380,381],{},"hangupInbound()"," only for queue-linked calls (",[97,384,385],{},"on_agent_call_linked",").",[86,388],{},[89,390,392],{"id":391},"showing-hangup-before-the-call-is-submitted","Showing Hangup Before the Call is Submitted",[82,394,395,396,398,399,402],{},"After ",[97,397,103],{}," is called, the SIP stack takes a moment to register the session. The hangup button should only appear after ",[97,400,401],{},"on_sending"," fires — not immediately after the user clicks Dial.",[106,404,405,508],{},[109,406,408],{"className":111,"code":407,"filename":113,"language":114,"meta":115,"style":115},"\u002F\u002F State machine: dialing → ringing → connected\nif (event.event_name === 'on_sending') isRinging = true   \u002F\u002F show Cancel\u002FHangup\nif (event.event_name === 'on_confirmed') isDial = true    \u002F\u002F show Hangup + Hold\u002FMute\nif (event.event_name === 'on_initiate_failed') isRinging = false \u002F\u002F hide Hangup\n",[97,409,410,415,450,479],{"__ignoreMap":115},[119,411,412],{"class":121,"line":122},[119,413,414],{"class":205},"\u002F\u002F State machine: dialing → ringing → connected\n",[119,416,417,420,423,425,428,431,433,435,437,440,443,447],{"class":121,"line":169},[119,418,419],{"class":172},"if",[119,421,422],{"class":125}," (event",[119,424,130],{"class":129},[119,426,427],{"class":125},"event_name ",[119,429,430],{"class":129},"===",[119,432,189],{"class":129},[119,434,401],{"class":143},[119,436,140],{"class":129},[119,438,439],{"class":125},") isRinging ",[119,441,442],{"class":129},"=",[119,444,446],{"class":445},"sfNiH"," true",[119,448,449],{"class":205},"   \u002F\u002F show Cancel\u002FHangup\n",[119,451,452,454,456,458,460,462,464,467,469,472,474,476],{"class":121,"line":202},[119,453,419],{"class":172},[119,455,422],{"class":125},[119,457,130],{"class":129},[119,459,427],{"class":125},[119,461,430],{"class":129},[119,463,189],{"class":129},[119,465,466],{"class":143},"on_confirmed",[119,468,140],{"class":129},[119,470,471],{"class":125},") isDial ",[119,473,442],{"class":129},[119,475,446],{"class":445},[119,477,478],{"class":205},"    \u002F\u002F show Hangup + Hold\u002FMute\n",[119,480,481,483,485,487,489,491,493,496,498,500,502,505],{"class":121,"line":209},[119,482,419],{"class":172},[119,484,422],{"class":125},[119,486,130],{"class":129},[119,488,427],{"class":125},[119,490,430],{"class":129},[119,492,189],{"class":129},[119,494,495],{"class":143},"on_initiate_failed",[119,497,140],{"class":129},[119,499,439],{"class":125},[119,501,442],{"class":129},[119,503,504],{"class":445}," false",[119,506,507],{"class":205}," \u002F\u002F hide Hangup\n",[109,509,511],{"className":111,"code":510,"filename":234,"language":114,"meta":115,"style":115},"\u002F\u002F Show Hangup immediately after dial() — SDK may reject the call before SIP sends\nisDialing = true\nvoice.dial(number, contactId, ext)\nshowHangupButton() \u002F\u002F premature — call may never actually go out\n",[97,512,513,518,528,549],{"__ignoreMap":115},[119,514,515],{"class":121,"line":122},[119,516,517],{"class":205},"\u002F\u002F Show Hangup immediately after dial() — SDK may reject the call before SIP sends\n",[119,519,520,523,525],{"class":121,"line":169},[119,521,522],{"class":125},"isDialing ",[119,524,442],{"class":129},[119,526,527],{"class":445}," true\n",[119,529,530,532,534,536,539,541,544,546],{"class":121,"line":202},[119,531,126],{"class":125},[119,533,130],{"class":129},[119,535,256],{"class":133},[119,537,538],{"class":125},"(number",[119,540,149],{"class":129},[119,542,543],{"class":125}," contactId",[119,545,149],{"class":129},[119,547,548],{"class":125}," ext)\n",[119,550,551,554,556],{"class":121,"line":209},[119,552,553],{"class":133},"showHangupButton",[119,555,364],{"class":125},[119,557,558],{"class":205},"\u002F\u002F premature — call may never actually go out\n",[82,560,561,564],{},[371,562,563],{},"Symptom:"," Hangup button visible but pressing it has no effect because no SIP session exists yet.",[86,566],{},[89,568,570],{"id":569},"agent-ready-state-surviving-outbound-calls-on-break","Agent Ready State Surviving Outbound Calls on Break",[82,572,573,574,577],{},"When an agent is on break and makes an outbound call, two SIP sessions exist simultaneously: the break (ready) session and the outbound session. When the outbound call ends, ",[97,575,576],{},"on_agent_logout_success"," fires for the outbound session — but the break session is still alive.",[106,579,580,696],{},[109,581,583],{"className":111,"code":582,"filename":113,"language":114,"meta":115,"style":115},"if (event.event_name === 'on_begin_break_success') isOnBreak = true\nif (event.event_name === 'on_end_break_success') isOnBreak = false\n\n\u002F\u002F Only clear isReady if not on break\nif (event.event_name === 'on_agent_logout_success') {\n  if (!isOnBreak) isReady = false\n}\n",[97,584,585,611,637,641,646,668,690],{"__ignoreMap":115},[119,586,587,589,591,593,595,597,599,602,604,607,609],{"class":121,"line":122},[119,588,419],{"class":172},[119,590,422],{"class":125},[119,592,130],{"class":129},[119,594,427],{"class":125},[119,596,430],{"class":129},[119,598,189],{"class":129},[119,600,601],{"class":143},"on_begin_break_success",[119,603,140],{"class":129},[119,605,606],{"class":125},") isOnBreak ",[119,608,442],{"class":129},[119,610,527],{"class":445},[119,612,613,615,617,619,621,623,625,628,630,632,634],{"class":121,"line":169},[119,614,419],{"class":172},[119,616,422],{"class":125},[119,618,130],{"class":129},[119,620,427],{"class":125},[119,622,430],{"class":129},[119,624,189],{"class":129},[119,626,627],{"class":143},"on_end_break_success",[119,629,140],{"class":129},[119,631,606],{"class":125},[119,633,442],{"class":129},[119,635,636],{"class":445}," false\n",[119,638,639],{"class":121,"line":202},[119,640,327],{"emptyLinePlaceholder":326},[119,642,643],{"class":121,"line":209},[119,644,645],{"class":205},"\u002F\u002F Only clear isReady if not on break\n",[119,647,648,650,652,654,656,658,660,662,664,666],{"class":121,"line":218},[119,649,419],{"class":172},[119,651,422],{"class":125},[119,653,130],{"class":129},[119,655,427],{"class":125},[119,657,430],{"class":129},[119,659,189],{"class":129},[119,661,576],{"class":143},[119,663,140],{"class":129},[119,665,196],{"class":125},[119,667,199],{"class":129},[119,669,670,672,674,677,680,682,685,688],{"class":121,"line":224},[119,671,173],{"class":172},[119,673,152],{"class":176},[119,675,676],{"class":129},"!",[119,678,679],{"class":125},"isOnBreak",[119,681,196],{"class":176},[119,683,684],{"class":125},"isReady",[119,686,687],{"class":129}," =",[119,689,636],{"class":445},[119,691,693],{"class":121,"line":692},7,[119,694,695],{"class":129},"}\n",[109,697,699],{"className":111,"code":698,"filename":234,"language":114,"meta":115,"style":115},"\u002F\u002F Blindly clearing isReady on every logout kills the break session indicator\nif (event.event_name === 'on_agent_logout_success') isReady = false\n",[97,700,701,706],{"__ignoreMap":115},[119,702,703],{"class":121,"line":122},[119,704,705],{"class":205},"\u002F\u002F Blindly clearing isReady on every logout kills the break session indicator\n",[119,707,708,710,712,714,716,718,720,722,724,727,729],{"class":121,"line":169},[119,709,419],{"class":172},[119,711,422],{"class":125},[119,713,130],{"class":129},[119,715,427],{"class":125},[119,717,430],{"class":129},[119,719,189],{"class":129},[119,721,576],{"class":143},[119,723,140],{"class":129},[119,725,726],{"class":125},") isReady ",[119,728,442],{"class":129},[119,730,636],{"class":445},[86,732],{},[89,734,736],{"id":735},"network-disconnect-dont-reset-to-login-screen","Network Disconnect — Don't Reset to Login Screen",[82,738,739,740,743],{},"When the network drops, ",[97,741,742],{},"on_disconnected"," fires. Resetting the UI back to the connect form loses the user's configuration and is disorienting. The SDK reconnects automatica
,843,847,851],{},[387,844,845],{},[95,846,598],{},[387,848,849],{},[95,850,711],{},[387,852,853],{},"Transfer initiated",[372,855,856,860,864],{},[387,857,858],{},[95,859,649],{},[387,861,862],{},[95,863,711],{},[387,865,866],{},"CSAT transfer initiated",[137,868],{},[86,870,872],{"id":871},"full-example","Full example",[113,874,876],{"className":145,"code":875,"language":147,"meta":121,"style":121},"import SocioVoice from 'sociomile-voice-sdk'\n\nconst sdk = new SocioVoice({\n  base_url: 'api.yourdomain.com',\n  secret_key: 'YOUR_SECRET_KEY',\n})\n\nawait sdk.start()\n\n\u002F\u002F Set agent ready to receive calls\nawait sdk.agentReady()\n\nsdk.on('sociomileEvent', async (event) => {\n  switch (event.event_name) {\n\n    case 'on_agent_login_success':\n      console.log('Agent is ready — waiting for calls')\n      break\n\n    case 'on_incoming_call':\n      console.log('Incoming:', event.data.from_display_name)\n      sdk.answerCall()\n      break\n\n    case 'on_inbound_confirmed':\n      console.log('Call active — audio started')\n      break\n\n    case 'on_inbound_ended':\n      console.log('Call ended')\n      break\n  }\n})\n\n\u002F\u002F Example: hold, resume, send CSAT, hang up\nasync function wrapUpCall() {\n  await sdk.holdInbound()\n  await new Promise(r => setTimeout(r, 5000))\n  await sdk.unholdInbound()\n\n  \u002F\u002F Route caller to CSAT survey, then disconnect\n  await sdk.sendCsat('9000')\n  await sdk.hangupInbound()\n}\n",[95,877,878,897,901,922,939,955,961,965,978,982,987,1000,1004,1036,1054,1059,1074,1095,1101,1106,1119,1152,1164,1169,1174,1187,1207,1212,1217,1230,1249,1254,1259,1266,1271,1277,1294,1308,1342,1355,1360,1366,1387,1400],{"__ignoreMap":121},[151,879,880,883,886,889,891,894],{"class":153,"line":154},[151,881,882],{"class":204},"import",[151,884,885],{"class":157}," SocioVoice ",[151,887,888],{"class":204},"from",[151,890,221],{"class":161},[151,892,893],{"class":175},"sociomile-voice-sdk",[151,895,896],{"class":161},"'\n",[151,
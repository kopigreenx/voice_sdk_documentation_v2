],{"id":863},"full-example","Full example",[105,866,868],{"className":137,"code":867,"language":139,"meta":113,"style":113},"import SocioVoice from 'sociomile-voice-sdk'\n\nconst sdk = new SocioVoice({\n  base_url: 'api.yourdomain.com',\n  secret_key: 'YOUR_SECRET_KEY',\n})\n\nawait sdk.start()\n\n\u002F\u002F Set agent ready to receive calls\nawait sdk.agentReady()\n\nsdk.on('sociomileEvent', async (event) => {\n  switch (event.event_name) {\n\n    case 'on_agent_login_success':\n      console.log('Agent is ready — waiting for calls')\n      break\n\n    case 'on_incoming_call':\n      console.log('Incoming:', event.data.from_display_name)\n      sdk.answerCall()\n      break\n\n    case 'on_inbound_confirmed':\n      console.log('Call active — audio started')\n      break\n\n    case 'on_inbound_ended':\n      console.log('Call ended')\n      break\n  }\n})\n\n\u002F\u002F Example: hold, resume, send CSAT, hang up\nasync function wrapUpCall() {\n  await sdk.holdInbound()\n  await new Promise(r => setTimeout(r, 5000))\n  await sdk.unholdInbound()\n\n  \u002F\u002F Route caller to CSAT survey, then disconnect\n  await sdk.sendCsat('9000')\n  await sdk.hangupInbound()\n}\n",[87,869,870,889,893,914,931,947,953,957,970,974,979,992,996,1028,1046,1051,1066,1087,1093,1098,1111,1144,1156,1161,1166,1179,1199,1204,1209,1222,1241,1246,1251,1258,1263,1269,1286,1300,1334,1347,1352,1358,1379,1392],{"__ignoreMap":113},[143,871,872,875,878,881,883,886],{"class":145,"line":146},[143,873,874],{"class":196},"import",[143,876,877],{"class":149}," SocioVoice ",[143,879,880],{"class":196},"from",[143,882,213],{"class":153},[143,884,885],{"class":167},"sociomile-voice-sdk",[143,887,888],{"class":153},"'\n",[143,890,891],{"class":145,"line":193},[143,892,305],{"emptyLinePlaceholder":304},[143,894,895,898,901,904,907,910,912],{"class":145,"line":226},[143,896,897],{"class":186},"const",[143,899,900],{"class":149}," sdk ",[143,902,903],{"class":153},"=",[143,905,906],{"class":153}," new",[1
53,854],{},[91,855,645],{},[383,857,858],{},[91,859,707],{},[383,861,862],{},"CSAT transfer initiated",[133,864],{},[82,866,868],{"id":867},"full-example","Full example",[109,870,872],{"className":141,"code":871,"language":143,"meta":117,"style":117},"import SocioVoice from 'sociomile-voice-sdk'\n\nconst sdk = new SocioVoice({\n  base_url: 'api.yourdomain.com',\n  secret_key: 'YOUR_SECRET_KEY',\n})\n\nawait sdk.start()\n\n\u002F\u002F Set agent ready to receive calls\nawait sdk.agentReady()\n\nsdk.on('sociomileEvent', async (event) => {\n  switch (event.event_name) {\n\n    case 'on_agent_login_success':\n      console.log('Agent is ready — waiting for calls')\n      break\n\n    case 'on_incoming_call':\n      console.log('Incoming:', event.data.from_display_name)\n      sdk.answerCall()\n      break\n\n    case 'on_inbound_confirmed':\n      console.log('Call active — audio started')\n      break\n\n    case 'on_inbound_ended':\n      console.log('Call ended')\n      break\n  }\n})\n\n\u002F\u002F Example: hold, resume, send CSAT, hang up\nasync function wrapUpCall() {\n  await sdk.holdInbound()\n  await new Promise(r => setTimeout(r, 5000))\n  await sdk.unholdInbound()\n\n  \u002F\u002F Route caller to CSAT survey, then disconnect\n  await sdk.sendCsat('9000')\n  await sdk.hangupInbound()\n}\n",[91,873,874,893,897,918,935,951,957,961,974,978,983,996,1000,1032,1050,1055,1070,1091,1097,1102,1115,1148,1160,1165,1170,1183,1203,1208,1213,1226,1245,1250,1255,1262,1267,1273,1290,1304,1338,1351,1356,1362,1383,1396],{"__ignoreMap":117},[147,875,876,879,882,885,887,890],{"class":149,"line":150},[147,877,878],{"class":200},"import",[147,880,881],{"class":153}," SocioVoice ",[147,883,884],{"class":200},"from",[147,886,217],{"class":157},[147,888,889],{"class":171},"sociomile-voice-sdk",[147,891,892],{"class":157},"'\n",[147,894,895],{"class":149,"line":197},[147,896,309],{"emptyLinePlaceholder":308},[147,898,899,902,905,908,911,914,916],{"class":149,"line":230},[147,900,901]
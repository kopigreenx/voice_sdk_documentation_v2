,[146,699,153],{"class":152},[146,701,157],{"class":156},[146,703,93],{"class":160},[146,705,706],{"class":163},"endBreak",[146,708,167],{"class":156},[176,710,711,721],{},[179,712,713],{},[182,714,715,719],{},[185,716,717],{},[102,718,189],{},[185,720,197],{},[199,722,723,733,745],{},[182,724,725,730],{},[204,726,727],{},[102,728,729],{},"on_end_break_started",[204,731,732],{},"End-break request sent",[182,734,735,740],{},[204,736,737],{},[102,738,739],{},"on_end_break_success",[204,741,742],{},[82,743,744],{},"Agent is back to Ready",[182,746,747,752],{},[204,748,749],{},[102,750,751],{},"on_already_end_break",[204,753,754],{},"Not on break — no-op",[132,756],{},[135,758,760],{"id":759},"state-machine-text-diagram","State machine (text diagram)",[95,762,765],{"className":763,"code":764,"language":100},[98],"┌─────────────┐   agentReady()     ┌─────────────┐\n│             │ ────────────────►  │             │\n│   Unready   │                    │    Ready    │◄─── receives inbound calls\n│             │ ◄────────────────  │             │\n└─────────────┘   agentUnready()   └──────┬──────┘\n                                          │\n                               beginBreak(id)│ endBreak()\n                                          │\n                                   ┌──────▼──────┐\n                                   │             │\n                                   │  On Break   │\n                                   │             │\n                                   └─────────────┘\n",[102,766,764],{"__ignoreMap":104},[132,768],{},[135,770,772],{"id":771},"full-example","Full example",[95,774,776],{"className":140,"code":775,"language":142,"meta":104,"style":104},"import SocioVoice from 'sociomile-voice-sdk'\n\nconst sdk = new SocioVoice({\n  base_url: 'api.yourdomain.com',\n  secret_key: 'YOUR_SECRET_KEY',\n})\n\nawait sdk.start()\n\nsdk.on('sociomileEvent', (event) => {\n  switch (event.event_name) {\n    case 'on_agent_login_success':\n      console.log('Ready — accepting calls')\n      break\n    case 'on_agent_logout_success':\n      console.log('Unready')\n      break\n    case 'on_fetch_breaks_success':\n      console.log('Available breaks:', event.data)\n      break\n    case 'on_begin_break_success':\n      console.log('On break')\n      break\n    case 'on_end_break_success':\n      console.log('Break ended — back to Ready')\n      break\n  }\n})\n\n\u002F\u002F Go ready\nawait sdk.agentReady()\n\n\u002F\u002F After a while, take a break\nconst breaks = await new Promise(resolve => {\n  sdk.once('sociomileEvent', e => {\n    if (e.event_name === 'on_fetch_breaks_success') resolve(e.data)\n  })\n  sdk.showBreaks()\n})\n\nconst [firstBreakId] = Object.keys(breaks)\nawait sdk.beginBreak(firstBreakId)\n\n\u002F\u002F 15 minutes later\nsetTimeout(async () => {\n  await sdk.endBreak()\n}, 15 * 60 * 1000)\n\n\u002F\u002F End of shift\n\u002F\u002F sdk.agentUnready()\n",[102,777,778,797,801,822,839,855,861,865,879,884,913,931,946,967,973,986,1005,1010,1023,1052,1057,1070,1090,1095,1108,1128,1133,1138,1145,1150,1156,1169,1174,1180,1208,1236,1273,1281,1292,1299,1304,1332,1346,1351,1357,1375,1389,1412,1417,1423],{"__ignoreMap":104},[146,779,780,783,786,789,791,794],{"class":148,"line":149},[146,781,782],{"class":152},"import",[146,784,785],{"class":156}," SocioVoice ",[146,787,788],{"class":152},"from",[146,790,328],{"class":160},[146,792,793],{"class":284},"sociomile-voice-sdk",[146,795,796],{"class":160},"'\n",[146,798,799],{"class":148,"line":310},[146,800,382],{"emptyLinePlaceholder":381},[146,802,803,806,809,812,815,818,820],{"class":148,"line":341},[146,804,805],{"class":303},"const",[146,807,808],{"class":156}," sdk ",[146,810,811],{"class":160},"=",[146,813,814],{"class":160}," new",[146,816,817],{"class":163}," SocioVoice",[146,819,278],{"class":156},[146,821,338],{"class":160},[146,823,824,827,830,832,835,837],{"class":148,"line":364},[146,825,826],{"class":316},"  base_url",[146,828,829],{"class":160},":",[1
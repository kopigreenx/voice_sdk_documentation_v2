694],{},"Already on break — no-op",[485,696,698],{"id":697},"_3-end-the-break","3 — End the break",[103,700,702],{"className":148,"code":701,"language":150,"meta":112,"style":112},"await sdk.endBreak()\n",[110,703,704],{"__ignoreMap":112},[154,705,706,708,710,712,715],{"class":156,"line":157},[154,707,161],{"class":160},[154,709,165],{"class":164},[154,711,101],{"class":168},[154,713,714],{"class":171},"endBreak",[154,716,175],{"class":164},[184,718,719,729],{},[187,720,721],{},[190,722,723,727],{},[193,724,725],{},[110,726,197],{},[193,728,205],{},[207,730,731,741,753],{},[190,732,733,738],{},[212,734,735],{},[110,736,737],{},"on_end_break_started",[212,739,740],{},"End-break request sent",[190,742,743,748],{},[212,744,745],{},[110,746,747],{},"on_end_break_success",[212,749,750],{},[90,751,752],{},"Agent is back to Ready",[190,754,755,760],{},[212,756,757],{},[110,758,759],{},"on_already_end_break",[212,761,762],{},"Not on break — no-op",[140,764],{},[143,766,768],{"id":767},"state-machine-text-diagram","State machine (text diagram)",[103,770,773],{"className":771,"code":772,"language":108},[106],"┌─────────────┐   agentReady()     ┌─────────────┐\n│             │ ────────────────►  │             │\n│   Unready   │                    │    Ready    │◄─── receives inbound calls\n│             │ ◄────────────────  │             │\n└─────────────┘   agentUnready()   └──────┬──────┘\n                                          │\n                               beginBreak(id)│ endBreak()\n                                          │\n                                   ┌──────▼──────┐\n                                   │             │\n                                   │  On Break   │\n                                   │             │\n                                   └─────────────┘\n",[110,774,772],{"__ignoreMap":112},[140,776],{},[143,778,780],{"id":779},"full-example","Full example",[103,782,784],{"className":148,"code":783,"language":150,"meta":112,"style":112},"import SocioVoice from 'sociomile-voice-sdk'\n\nconst sdk = new SocioVoice({\n  base_url: 'api.yourdomain.com',\n  secret_key: 'YOUR_SECRET_KEY',\n})\n\nawait sdk.start()\n\nsdk.on('sociomileEvent', (event) => {\n  switch (event.event_name) {\n    case 'on_agent_login_success':\n      console.log('Ready — accepting calls')\n      break\n    case 'on_agent_logout_success':\n      console.log('Unready')\n      break\n    case 'on_fetch_breaks_success':\n      console.log('Available breaks:', event.data)\n      break\n    case 'on_begin_break_success':\n      console.log('On break')\n      break\n    case 'on_end_break_success':\n      console.log('Break ended — back to Ready')\n      break\n  }\n})\n\n\u002F\u002F Go ready\nawait sdk.agentReady()\n\n\u002F\u002F After a while, take a break\nconst breaks = await new Promise(resolve => {\n  sdk.once('sociomileEvent', e => {\n    if (e.event_name === 'on_fetch_breaks_success') resolve(e.data)\n  })\n  sdk.showBreaks()\n})\n\nconst [firstBreakId] = Object.keys(breaks)\nawait sdk.beginBreak(firstBreakId)\n\n\u002F\u002F 15 minutes later\nsetTimeout(async () => {\n  await sdk.endBreak()\n}, 15 * 60 * 1000)\n\n\u002F\u002F End of shift\n\u002F\u002F sdk.agentUnready()\n",[110,785,786,805,809,830,847,863,869,873,887,892,921,939,954,975,981,994,1013,1018,1031,1060,1065,1078,1098,1103,1116,1136,1141,1146,1153,1158,1164,1177,1182,1188,1216,1244,1281,1289,1300,1307,1312,1340,1354,1359,1365,1383,1397,1420,1425,1431],{"__ignoreMap":112},[154,787,788,791,794,797,799,802],{"class":156,"line":157},[154,789,790],{"class":160},"import",[154,792,793],{"class":164}," SocioVoice ",[154,795,796],{"class":160},"from",[154,798,336],{"class":168},[154,800,801],{"class":292},"sociomile-voice-sdk",[154,803,804],{"class":168},"'\n",[154,806,807],{"class":156,"line":318},[154,808,390],{"emptyLinePlaceholder":389},[154,810,811,814,817,820,823,826,828],{"class":156,"line":349},[154,812,813],{"class":311},"const",[154,815,816],{"class":164}," sdk ",[1
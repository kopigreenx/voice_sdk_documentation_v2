,"style":108},"await sdk.endBreak()\n",[106,699,700],{"__ignoreMap":108},[150,701,702,704,706,708,711],{"class":152,"line":153},[150,703,157],{"class":156},[150,705,161],{"class":160},[150,707,97],{"class":164},[150,709,710],{"class":167},"endBreak",[150,712,171],{"class":160},[180,714,715,725],{},[183,716,717],{},[186,718,719,723],{},[189,720,721],{},[106,722,193],{},[189,724,201],{},[203,726,727,737,749],{},[186,728,729,734],{},[208,730,731],{},[106,732,733],{},"on_end_break_started",[208,735,736],{},"End-break request sent",[186,738,739,744],{},[208,740,741],{},[106,742,743],{},"on_end_break_success",[208,745,746],{},[86,747,748],{},"Agent is back to Ready",[186,750,751,756],{},[208,752,753],{},[106,754,755],{},"on_already_end_break",[208,757,758],{},"Not on break — no-op",[136,760],{},[139,762,764],{"id":763},"state-machine-text-diagram","State machine (text diagram)",[99,766,769],{"className":767,"code":768,"language":104},[102],"┌─────────────┐   agentReady()     ┌─────────────┐\n│             │ ────────────────►  │             │\n│   Unready   │                    │    Ready    │◄─── receives inbound calls\n│             │ ◄────────────────  │             │\n└─────────────┘   agentUnready()   └──────┬──────┘\n                                          │\n                               beginBreak(id)│ endBreak()\n                                          │\n                                   ┌──────▼──────┐\n                                   │             │\n                                   │  On Break   │\n                                   │             │\n                                   └─────────────┘\n",[106,770,768],{"__ignoreMap":108},[136,772],{},[139,774,776],{"id":775},"full-example","Full example",[99,778,780],{"className":144,"code":779,"language":146,"meta":108,"style":108},"import SocioVoice from 'sociomile-voice-sdk'\n\nconst sdk = new SocioVoice({\n  base_url: 'api.yourdomain.com',\n  secret_key: 'YOUR_SECRET_KEY',\n})\n\nawait sdk.start()\n\nsdk.on('sociomileEvent', (event) => {\n  switch (event.event_name) {\n    case 'on_agent_login_success':\n      console.log('Ready — accepting calls')\n      break\n    case 'on_agent_logout_success':\n      console.log('Unready')\n      break\n    case 'on_fetch_breaks_success':\n      console.log('Available breaks:', event.data)\n      break\n    case 'on_begin_break_success':\n      console.log('On break')\n      break\n    case 'on_end_break_success':\n      console.log('Break ended — back to Ready')\n      break\n  }\n})\n\n\u002F\u002F Go ready\nawait sdk.agentReady()\n\n\u002F\u002F After a while, take a break\nconst breaks = await new Promise(resolve => {\n  sdk.once('sociomileEvent', e => {\n    if (e.event_name === 'on_fetch_breaks_success') resolve(e.data)\n  })\n  sdk.showBreaks()\n})\n\nconst [firstBreakId] = Object.keys(breaks)\nawait sdk.beginBreak(firstBreakId)\n\n\u002F\u002F 15 minutes later\nsetTimeout(async () => {\n  await sdk.endBreak()\n}, 15 * 60 * 1000)\n\n\u002F\u002F End of shift\n\u002F\u002F sdk.agentUnready()\n",[106,781,782,801,805,826,843,859,865,869,883,888,917,935,950,971,977,990,1009,1014,1027,1056,1061,1074,1094,1099,1112,1132,1137,1142,1149,1154,1160,1173,1178,1184,1212,1240,1277,1285,1296,1303,1308,1336,1350,1355,1361,1379,1393,1416,1421,1427],{"__ignoreMap":108},[150,783,784,787,790,793,795,798],{"class":152,"line":153},[150,785,786],{"class":156},"import",[150,788,789],{"class":160}," SocioVoice ",[150,791,792],{"class":156},"from",[150,794,332],{"class":164},[150,796,797],{"class":288},"sociomile-voice-sdk",[150,799,800],{"class":164},"'\n",[150,802,803],{"class":152,"line":314},[150,804,386],{"emptyLinePlaceholder":385},[150,806,807,810,813,816,819,822,824],{"class":152,"line":345},[150,808,809],{"class":307},"const",[150,811,812],{"class":160}," sdk ",[150,814,815],{"class":164},"=",[150,817,818],{"class":164}," new",[150,820,821],{"class":167}," SocioVoice",[150,823,282],{"class":160},[150,825,342],{"class":164},[150,8